# SnowNinja Environment Variables Template
# Copy this to .env and fill in your details

# --- Required ---
SNOWFLAKE_ACCOUNT=xy12345.region
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
NVIDIA_API_KEY=nvapi-...

# --- Optional ---
# Set to 1 to enable verbose debug logging in the TUI
SNOWNINJA_DEBUG=0

# Default model overrides
# SNOWNINJA_PLANNER=meta/llama-4-maverick-17b-128e-instruct
# SNOWNINJA_IMPLEMENTER=qwen/qwen3-coder-480b-a35b-instruct
